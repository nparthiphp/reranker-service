# Reranker Service — environment config
# Copy to .env and adjust

# ── Models ────────────────────────────────────────────────────
# Cross-encoder options (quality vs speed):
#   cross-encoder/ms-marco-MiniLM-L-6-v2   67MB  fastest  (default)
#   cross-encoder/ms-marco-MiniLM-L-12-v2  130MB better
#   cross-encoder/ms-marco-electra-base     420MB best quality
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Must match the bi-encoder used by your RAG pipeline
EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1

# ── Defaults ──────────────────────────────────────────────────
DEFAULT_TOP_K=3
DEFAULT_MMR_LAMBDA=0.7         # 0.0=diverse, 1.0=relevant, 0.7=balanced

# ── Security ──────────────────────────────────────────────────
# Leave empty to disable auth (development)
# Set a strong secret for production
API_KEY=

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true
ENABLE_METRICS=true

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development        # development | staging | production
PORT=8001
PREWARM_ON_STARTUP=true
